{
  // Vertical column rulers:
  // 80 is the classic PEP 8 width guide; 100 is the hard upper ceiling.
  "editor.rulers": [80, 100],

  // Python & Ruff auto-formatting and import sorting on save
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },

  // Pylance static type checking ("standard" enforces clean type annotations)
  "python.analysis.typeCheckingMode": "standard",

  // Automatically point VS Code to uv's virtual environment
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
}
